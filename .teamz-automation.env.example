# Project-level overrides for teamz-company-automation.
# Copy to your host project root as `.teamz-automation.env`.

# Required for multi-project reuse
TEAMZ_PROJECT_TYPE=website
TEAMZ_SITE_URL=https://tool.teamzlab.com/
TEAMZ_SITE_PROPERTY=https://tool.teamzlab.com/
TEAMZ_HOST_SITE_ROOT=/absolute/path/to/your/project

# Optional token/config overrides
TEAMZ_CONFIG_DIR=$HOME/.config/teamzlab
TEAMZ_SC_TOKEN_FILE=$HOME/.config/teamzlab/search-console-token.json
TEAMZ_GA4_TOKEN_FILE=$HOME/.config/teamzlab/analytics-token.json
TEAMZ_ADSENSE_TOKEN_FILE=$HOME/.config/teamzlab/adsense-token.json
TEAMZ_PAGESPEED_KEY_FILE=$HOME/.config/teamzlab/pagespeed-api-key.txt
TEAMZ_CLARITY_TOKEN_FILE=$HOME/.config/teamzlab/clarity-token.txt
TEAMZ_BING_API_KEY_FILE=$HOME/.config/teamzlab/bing-webmaster-api-key.txt
TEAMZ_PRODUCTHUNT_TOKEN_FILE=$HOME/.config/teamzlab/producthunt-token.txt
TEAMZ_GA4_PROPERTY_ID=528521795
TEAMZ_GOOGLE_CLOUD_PROJECT=teamzlab-tools

# Data/report storage (optional)
TEAMZ_DATA_DIR=/absolute/path/to/teamz-company-automation/data
TEAMZ_REPORT_DIR=/absolute/path/to/project/docs
TEAMZ_TOP_PAGES_FILE=docs/top-pages.txt

# Optional site metadata for backlinks/distribution
TEAMZ_SITE_NAME=Teamz Lab Tools
TEAMZ_SITE_EMAIL=teamz.lab.contact@gmail.com
TEAMZ_SITE_OWNER=Teamz Lab LTD

# ASO config (for py/aso/ scripts)
TEAMZ_APP_IDS=
TEAMZ_ASO_COUNTRIES=us,gb,au,ca,in
TEAMZ_ASO_KEYWORDS=

# Google Play Console (service account JSON — same or different GCP project as Search Console)
# Create SA in GCP → enable Play Developer Reporting API + Google Play Android Developer API →
# invite SA email in Play Console (view app info + manage store presence for listing edits).
# pip3 install google-api-python-client google-auth
TEAMZ_PLAY_SERVICE_ACCOUNT_JSON=$HOME/.config/teamzlab/play-console-service-account.json
TEAMZ_PLAY_PACKAGE_NAME=

# SEO monitoring config
TEAMZ_BRAND_KEYWORDS=
TEAMZ_REDDIT_SUBS=InternetIsBeautiful,webdev,SEO,personalfinance
TEAMZ_COMPETITOR_DOMAINS=
TEAMZ_SERP_KEYWORDS=
