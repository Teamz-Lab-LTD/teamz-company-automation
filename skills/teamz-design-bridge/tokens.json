{
  "$schema": "./tokens.schema.json",
  "notes": "Abstract, stack-agnostic design tokens. Every Teamz platform has its own mapping to the concrete tokens — see platforms/*.md. Never emit raw colors/fonts in generated code; always use a token name that maps to one of these.",
  "colors": {
    "background":       { "role": "page background",                       "pairsWith": "onBackground" },
    "onBackground":     { "role": "body text/icon on page",                "role.contrastTarget": "AA" },
    "surface":          { "role": "card/sheet background",                 "pairsWith": "onSurface" },
    "onSurface":        { "role": "body text/icon on a card",              "role.contrastTarget": "AA" },
    "surfaceVariant":   { "role": "quieter card (chips, dividers)",        "pairsWith": "onSurfaceVariant" },
    "onSurfaceVariant": { "role": "muted text/icon on surfaceVariant",     "role.contrastTarget": "AA" },
    "primary":          { "role": "brand accent (CTAs, progress)",         "pairsWith": "onPrimary" },
    "onPrimary":        { "role": "text/icon on primary",                  "role.contrastTarget": "AA" },
    "secondary":        { "role": "complement accent",                     "pairsWith": "onSecondary" },
    "onSecondary":      { "role": "text/icon on secondary" },
    "success":          { "role": "positive status",                       "pairsWith": "onStatus" },
    "warning":          { "role": "attention status",                      "pairsWith": "onStatus" },
    "error":            { "role": "destructive status",                    "pairsWith": "onStatus" },
    "onStatus":         { "role": "text/icon on success/warning/error" },
    "outline":          { "role": "borders, dividers" },
    "shadow":           { "role": "elevation shadow" }
  },
  "typography": {
    "displayLarge":  { "role": "hero title, >= 48sp/56px", "weight": "semi-bold" },
    "displayMedium": { "role": "section hero",              "weight": "semi-bold" },
    "headlineLarge": { "role": "page title" },
    "headlineSmall": { "role": "sheet/card title" },
    "titleLarge":    { "role": "list-item primary text" },
    "titleMedium":   { "role": "emphasized body (chip, tab label)" },
    "bodyLarge":     { "role": "primary body text" },
    "bodyMedium":    { "role": "secondary body text" },
    "labelLarge":    { "role": "buttons, form labels" },
    "labelSmall":    { "role": "metadata (timestamps, microcopy)" }
  },
  "spacing": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" },
    "2xl":{ "value": "48px" },
    "3xl":{ "value": "64px" }
  },
  "radius": {
    "xs":  "4px",
    "sm":  "8px",
    "md":  "12px",
    "lg":  "16px",
    "pill":"999px"
  },
  "motion": {
    "fastMs":  150,
    "midMs":   250,
    "slowMs":  400,
    "easing":  "cubic-bezier(0.2, 0, 0, 1)"
  },
  "breakpoints": {
    "mobile":  "< 600px",
    "tablet":  "600-1023px",
    "desktop": ">= 1024px"
  }
}
