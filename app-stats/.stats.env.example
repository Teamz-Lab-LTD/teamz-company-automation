# ─── App Stats Config ────────────────────────────────────────────
# Copy this to your project root as `.stats.env` and fill in values.
# NEVER commit the real `.stats.env` — add it to .gitignore.
#
# Most iOS (ASC) values are inherited from `.appstore-fastlane.env` if present,
# so you only need to set things unique to stats here.

# ─── Display name used in report header ──────────────────────────
APP_NAME=Your App Name

# ─── Output location for the generated markdown report ──────────
# Defaults to project-root/app-stats-reports/ if unset.
REPORT_OUT_DIR=app-stats-reports

# ─── iOS / App Store Connect ─────────────────────────────────────
# Reused from .appstore-fastlane.env if defined there:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_FILEPATH, APPLE_APP_ID, APP_BUNDLE_ID
#
# Unique to stats:
# ASC_VENDOR_NUMBER — find at: App Store Connect → Payments & Financial Reports
#                     → top-right dropdown shows "Vendor #XXXXXXXX"
ASC_VENDOR_NUMBER=

# ─── Android / Google Play Console ───────────────────────────────
# Service account JSON with "View financial data" permission on the app.
# Download from Play Console → Setup → API access.
GOOGLE_APPLICATION_CREDENTIALS=~/.config/teamzlab/play-console-service-account.json
ANDROID_PACKAGE=com.teamzlab.yourapp

# PLAY_REPORTS_BUCKET — copy from Play Console → Download reports →
#   Statistics → "Copy Cloud Storage URI". Strip the gs:// prefix.
#   Looks like: pubsite_prod_rev_01234567890123456789
PLAY_REPORTS_BUCKET=

# ─── AdMob ───────────────────────────────────────────────────────
# Generate admob-token.json via OAuth flow (see README).
ADMOB_TOKEN_FILE=~/.config/teamzlab/admob-token.json
# From AdMob UI → Account Info → Publisher ID (format: pub-XXXXXXXXXXXXXXXX)
ADMOB_PUBLISHER_ID=
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=

# ─── GA4 ─────────────────────────────────────────────────────────
# Service account or OAuth token with "Viewer" on the GA4 property.
ANALYTICS_TOKEN_FILE=~/.config/teamzlab/analytics-token.json
# GA4 → Admin → Property Settings → Property ID (numeric, e.g. 123456789)
GA4_PROPERTY_ID=
