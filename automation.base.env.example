# Machine-level shared defaults for all projects.
# Copy to ~/.config/teamzlab/automation.base.env

TEAMZ_CONFIG_DIR=$HOME/.config/teamzlab
TEAMZ_SC_TOKEN_FILE=$HOME/.config/teamzlab/search-console-token.json
TEAMZ_GA4_TOKEN_FILE=$HOME/.config/teamzlab/analytics-token.json
TEAMZ_ADSENSE_TOKEN_FILE=$HOME/.config/teamzlab/adsense-token.json
TEAMZ_PAGESPEED_KEY_FILE=$HOME/.config/teamzlab/pagespeed-api-key.txt
TEAMZ_CLARITY_TOKEN_FILE=$HOME/.config/teamzlab/clarity-token.txt
TEAMZ_BING_API_KEY_FILE=$HOME/.config/teamzlab/bing-webmaster-api-key.txt
TEAMZ_PRODUCTHUNT_TOKEN_FILE=$HOME/.config/teamzlab/producthunt-token.txt

# Shared defaults (projects can override)
TEAMZ_PROJECT_TYPE=website
TEAMZ_GOOGLE_CLOUD_PROJECT=teamzlab-tools
TEAMZ_SITE_EMAIL=teamz.lab.contact@gmail.com
TEAMZ_SITE_OWNER=Teamz Lab LTD
