# ─── App Store Fastlane Config ───────────────────────────────────
# Copy this to your project root as `.appstore-fastlane.env`
# and fill in the values for your specific app.
#
# NEVER commit this file — add `.appstore-fastlane.env` to .gitignore

# ─── App Store Connect API Key ───────────────────────────────────
# Generate at: https://appstoreconnect.apple.com/access/integrations/api
# Download the .p8 file and store it securely (e.g., ~/.config/teamzlab/)
# These are pre-filled for Teamz Lab — same key works for ALL projects
ASC_KEY_ID=559DD92MBH
ASC_ISSUER_ID=100d6ef8-7452-4aff-85a4-990158b60b3d
ASC_KEY_FILEPATH=~/.config/teamzlab/AuthKey_559DD92MBH.p8

# ─── Apple Developer Team ───────────────────────────────────────
ASC_TEAM_ID=NDV83KC5LC
COMPANY_NAME=Teamz Lab LTD

# ─── App Details ─────────────────────────────────────────────────
APP_NAME=Your App Name
APP_BUNDLE_ID=com.teamzlab.yourapp
APP_SKU=com.teamzlab.yourapp
APP_PRIMARY_LANGUAGE=English
APPLE_APP_ID=

# ─── URLs ────────────────────────────────────────────────────────
PRIVACY_URL=https://teamzlab.com/privacy-policy
SUPPORT_URL=https://teamzlab.com/privacy-policy
MARKETING_URL=https://teamzlab.com

# ─── App Review Contact ─────────────────────────────────────────
REVIEW_FIRST_NAME=Teamz
REVIEW_LAST_NAME=Lab
REVIEW_PHONE=+447490356046
REVIEW_EMAIL=teamz.lab.contact@gmail.com

# ─── Submission Settings ─────────────────────────────────────────
AUTO_RELEASE=false
USES_IDFA=false
SERVES_ADS=true

# ─── TestFlight ──────────────────────────────────────────────────
TESTFLIGHT_GROUPS=External Testers

# ─── Build Paths (set when uploading) ───────────────────────────
# IPA_PATH=build/ios/ipa/YourApp.ipa
